# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# These values are injected at build time by Expo — they are NOT secret on the client.
# Actual secrets (API keys, DB credentials) ONLY live on the backend.

EXPO_PUBLIC_API_BASE_URL=https://api.yourplatform.com/v1
EXPO_PUBLIC_PREVIEW_BASE_URL=https://preview.yourplatform.com

# GitHub PAT for pushing changes to the template repo (MahtoHimanshu/website-service).
# Needs the "repo" scope. In production, use the in-app GitHub credentials form instead.
EXPO_PUBLIC_GITHUB_PAT=ghp_your_token_here
